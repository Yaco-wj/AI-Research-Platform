# ===== 业务数据库（SQLAlchemy + asyncpg）=====
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/deep_research

# ===== LangGraph Checkpoint（PostgresSaver，使用 psycopg 连接串）=====
# 注意：必须使用 postgresql:// 而不是 postgresql+asyncpg://
LANGGRAPH_DATABASE_URL=postgresql://postgres:password@localhost:5432/deep_research

# ===== Web 服务 =====
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
SQL_ECHO=false

# ===== Checkpoint 连接池 =====
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=5

# Agent 的模型、搜索和 MCP 配置统一放在仓库根目录 .env。
# 后端也会读取根目录 .env；两份配置同时存在时 backend/.env 优先。
